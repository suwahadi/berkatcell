APP_NAME=berkatcell
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Uji pembayaran dari luar (Nicepay, webhook Midtrans) butuh URL publik lewat tunnel.
# Buka situs lewat URL itu, bukan lewat localhost. Contoh:
# APP_URL=https://obstacle-striking-gown.ngrok-free.dev

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbname
DB_USERNAME=userdb
DB_PASSWORD=xxxxxxxx

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@berkatcell.com"
MAIL_FROM_NAME="${APP_NAME}"

# === RajaOngkir (Komerce) ===
RAJAONGKIR_API_KEY=xxxxxxxxxxxxx
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_MOCK=false

# === Email (Brevo) ===
BREVO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_NAME="CV. Berkat Cell"
BREVO_SENDER_EMAIL="no-reply@berkatcell.com"
BREVO_ADMIN_EMAIL="admin@berkatcell.com"

# === Payment Gateway (Midtrans) ===
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=XXX
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxx
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxx
MIDTRANS_SANITIZE=true
MIDTRANS_3DS=true

# === Payment Gateway (Nicepay - Indodana PayLater) ===
# Sandbox: iMid PAYLOANTES dengan merchantKey uji publik dari
# https://docs.nicepay.co.id/nicepay-api-non-snap-authentication (nilai di bawah).
# iMid IONPAYTEST tidak mengaktifkan Indodana (resultCd 9108).
# Akun uji Indodana di sandbox: telepon 62838499610, OTP 999999, PIN 123654.
# Produksi: iMid dan merchantKey dari MMS (https://bo.nicepay.co.id/logIn.do),
# menu Profile > Merchant Data > tab Other, lalu NICEPAY_IS_PRODUCTION=true.
# Nicepay menolak URL localhost di data pesanan, jadi buka situs lewat URL publik.
NICEPAY_ENABLED=false
NICEPAY_ADMIN_ONLY=true
NICEPAY_IS_PRODUCTION=false
NICEPAY_IMID=PAYLOANTES
NICEPAY_MERCHANT_KEY="33F49GnCMS1mFYlGXisbUDzVf2ATWCl9k3R++d5hDd3Frmuos/XLx8XhXpe+LDYAbpGKZYSwtlyyLOtS/8aD7A=="
NICEPAY_EXPIRY_MINUTES=1440
NICEPAY_STORE_CITY="Jakarta Utara"
NICEPAY_STORE_STATE="DKI Jakarta"
NICEPAY_STORE_POSTCODE=14440
NICEPAY_DEVELOPMENT_URL=https://dev.nicepay.co.id
NICEPAY_PRODUCTION_URL=https://www.nicepay.co.id

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
